    "end": 4.193,
    "text": "That's Riya's Monday morning."
  },
  {
    "id": 2,
    "start": 4.743,
    "end": 5.98,
    "text": "Every Monday morning."
  },
  {
    "id": 3,
    "start": 7.03,
    "end": 8.694,
    "text": "Underneath all of it, one note."
  },
  {
    "id": 4,
    "start": 9.044,
    "end": 10.196,
    "text": "Three years old."
  },
  {
    "id": 5,
    "start": 11.646,
    "end": 13.715,
    "text": "It says: become a software engineer."
  },
  {
    "id": 6,
    "start": 14.315,
    "end": 16.384,
    "text": "And every morning, the same question."
  },
  {
    "id": 7,
    "start": 16.834,
    "end": 18.455,
    "text": "What do I actually do today?"
  },
  {
    "id": 8,
    "start": 19.205,
    "end": 20.478,
    "text": "Forty-seven tabs."
  },
  {
    "id": 9,
    "start": 20.728,
    "end": 22.13,
    "text": "Three complete roadmaps."
  },
  {
    "id": 10,
    "start": 22.38,
    "end": 24.184,
    "text": "One course, twelve percent done."
  },
  {
    "id": 11,
    "start": 24.634,
    "end": 25.906,
    "text": "New plan on Sunday."
  },
  {
    "id": 12,
    "start": 26.156,
    "end": 27.167,
    "text": "Missed Wednesday."
  },
  {
    "id": 13,
    "start": 27.417,
    "end": 28.585,
    "text": "Start over Friday."
  },
  {
    "id": 14,
    "start": 29.135,
    "end": 30.709,
    "text": "The goal was never too big."
  },
  {
    "id": 15,
    "start": 31.009,
    "end": 32.551,
    "text": "Nobody turned it into today."
  },
  {
    "id": 16,
    "start": 33.351,
    "end": 34.997,
    "text": "What if your goal came with a Monday?"
  },
  {
    "id": 17,
    "start": 35.497,
    "end": 36.834,
    "text": "This is Zero to One."
  },
  {
    "id": 18,
    "start": 37.334,
    "end": 41.149,
    "text": "She tells it the goal, where she's starting, and the hour a day she really has."
  },
  {
    "id": 19,
    "start": 41.449,
    "end": 44.752,
    "text": "It turns three years into phases, milestones, and tasks."
  },
  {
    "id": 20,
    "start": 45.002,
    "end": 46.094,
    "text": "Then into today."
  },
  {
    "id": 21,
    "start": 46.294,
    "end": 50.145,
    "text": "Monday, nine A.M. Twenty-five minutes. JavaScript basics."
  },
  {
    "id": 22,
    "start": 50.545,
    "end": 53.335,
    "text": "Miss a day? The plan moves. Nothing piles up."
  },
  {
    "id": 23,
    "start": 53.685,
    "end": 56.96,
    "text": "Only thirty minutes? Ask. It reshapes today. She decides."
  },
  {
    "id": 24,
    "start": 57.61,
    "end": 59.165,
    "text": "Riya's note never changed."
  },
  {
    "id": 25,
    "start": 59.565,
    "end": 60.593,
    "text": "Her Monday did."
  },
  {
    "id": 26,
    "start": 61.293,
    "end": 65.178,
    "text": "Zero to One. Big goals. Clear next steps. Join the waitlist."
  }
