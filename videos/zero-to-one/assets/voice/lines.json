[
  { "id": 1, "start": 2.7, "end": 4.193, "text": "That's Riya's Monday morning." },
  { "id": 2, "start": 4.743, "end": 5.98, "text": "Every Monday morning." },
  { "id": 3, "start": 7.03, "end": 8.694, "text": "Underneath all of it, one note." },
  { "id": 4, "start": 9.044, "end": 10.196, "text": "Three years old." },
  { "id": 5, "start": 11.646, "end": 13.715, "text": "It says: become a software engineer." },
  { "id": 6, "start": 14.315, "end": 16.384, "text": "And every morning, the same question." },
  { "id": 7, "start": 16.834, "end": 18.455, "text": "What do I actually do today?" },
  { "id": 8, "start": 19.405, "end": 20.728, "text": "Forty-seven tabs." },
  { "id": 9, "start": 20.978, "end": 22.45, "text": "Three complete roadmaps." },
  { "id": 10, "start": 22.7, "end": 24.577, "text": "One course, twelve percent done." },
  { "id": 11, "start": 25.177, "end": 26.5, "text": "New plan on Sunday." },
  { "id": 12, "start": 26.75, "end": 27.795, "text": "Missed Wednesday." },
  { "id": 13, "start": 28.045, "end": 29.261, "text": "Start over Friday." },
  { "id": 14, "start": 29.961, "end": 31.604, "text": "The goal was never too big." },
  { "id": 15, "start": 31.904, "end": 33.504, "text": "Nobody turned it into today." },
  { "id": 16, "start": 34.404, "end": 36.111, "text": "What if your goal came with a Monday?" },
  { "id": 17, "start": 36.711, "end": 38.098, "text": "This is Zero to One." },
  {
    "id": 18,
    "start": 38.698,
    "end": 42.709,
    "text": "She tells it the goal, where she's starting, and the hour a day she really has."
  },
  {
    "id": 19,
    "start": 43.009,
    "end": 46.486,
    "text": "It turns three years into phases, milestones, and tasks."
  },
  { "id": 20, "start": 46.786, "end": 47.917, "text": "Then into today." },
  {
    "id": 21,
    "start": 48.117,
    "end": 52.149,
    "text": "Monday, nine A.M. Twenty-five minutes. JavaScript basics."
  },
  {
    "id": 22,
    "start": 52.649,
    "end": 55.572,
    "text": "Miss a day? The plan moves. Nothing piles up."
  },
  {
    "id": 23,
    "start": 55.972,
    "end": 59.407,
    "text": "Only thirty minutes? Ask. It reshapes today. She decides."
  },
  { "id": 24, "start": 60.207, "end": 61.828, "text": "Riya's note never changed." },
  { "id": 25, "start": 62.328, "end": 63.395, "text": "Her Monday did." },
  {
    "id": 26,
    "start": 64.195,
    "end": 68.27,
    "text": "Zero to One. Big goals. Clear next steps. Join the waitlist."
  }
]
